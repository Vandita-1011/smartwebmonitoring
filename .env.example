# SmartWeb Sentinel - Mobile SMS Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES

# VIT WEBSITES TO MONITOR
MONITOR_URLS=https://vit.ac.in,https://vit.ac.in/exam-results

# SCAN SETTINGS (600 seconds = 10 minutes)
SCAN_INTERVAL=600

# SMS CONFIGURATION - USING FREE SMS APIs
SMS_ENABLED=true
PHONE_NUMBER=9392871897

# Choose one SMS API (all are free):
# - textbelt (1 free SMS per day)
# - callmebot (free)
# - fast2sms (requires API key but free)
SMS_API=textbelt